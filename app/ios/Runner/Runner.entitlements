<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Shared by every Apple target: app/apple/keychain.entitlements (tools/apple_sync.dart writes this block). -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.foehammer.liquiflux</string>
	</array>
	<!-- End of app/apple/keychain.entitlements. -->
</dict>
</plist>
